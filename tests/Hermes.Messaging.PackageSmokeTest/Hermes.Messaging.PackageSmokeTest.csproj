<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      This project intentionally references the PACKAGED Hermes.Messaging (from the local
      artifacts feed), NOT the source project. It proves the shipped NuGet package exposes exactly
      the public API a real consumer uses. The version is provided by CI via -p:HermesPackageVersion,
      defaulting to the current dev version.
    -->
    <HermesPackageVersion Condition="'$(HermesPackageVersion)' == ''">0.3.0-alpha</HermesPackageVersion>
    <!-- Not part of the solution build; packed/consumed explicitly in the smoke-test CI step. -->
    <ExcludeFromSolution>true</ExcludeFromSolution>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hermes.Messaging" Version="$(HermesPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
  </ItemGroup>

</Project>
