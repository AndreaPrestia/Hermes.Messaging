<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Hermes.Messaging</PackageId>
    <Version>0.4.0-alpha</Version>
    <Authors>Andrea Prestia</Authors>
    <Description>In-process, single-process durable message bus for .NET built on System.Threading.Channels with LiteDB persistence. Publish-before-signal durability, a durable state machine with crash recovery, persistent retry with jittered backoff, a durable dead-letter queue, explicit runtime lifecycle, and OpenTelemetry-compatible metrics and tracing (Hermes.Messaging).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>messagebus;channels;messaging;in-process;durable;litedb;retry;dead-letter-queue;opentelemetry</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/AndreaPrestia/Hermes.Messaging</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <!-- Deterministic build in CI (GitHub Actions sets CI=true). -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Ship XML docs so IntelliSense works for consumers. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing-XML-comment noise is not useful here; public API is documented pragmatically. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests exercise internal implementation types directly (state machine, store, registries). -->
    <InternalsVisibleTo Include="Hermes.Messaging.Tests" />
    <!-- Benchmarks seed the durable store directly for backlog-recovery measurements; they are
         internal tooling, not a consumer contract, so internal visibility is appropriate. -->
    <InternalsVisibleTo Include="Hermes.Messaging.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <!--
    Public API surface guard: the intended public API is captured as a checked-in baseline
    (docs/api/PublicAPI.txt) and asserted by PublicApiSurfaceTests. Any accidental new/changed
    public type or member fails that test until a maintainer deliberately updates the baseline.
    A lightweight reflection snapshot was chosen over Microsoft.CodeAnalysis.PublicApiAnalyzers to
    avoid a prerelease analyzer dependency and a large hand-maintained canonical signature file.
  -->

  <!--
    SourceLink is built into the .NET 10 SDK; with PublishRepositoryUrl + ContinuousIntegrationBuild
    + EmbedUntrackedSources set above, package builds embed repo/commit metadata without needing the
    external Microsoft.SourceLink.GitHub package (which drags in a transitively-vulnerable
    Microsoft.Build.Tasks.Git, NU1902).
  -->

</Project>
